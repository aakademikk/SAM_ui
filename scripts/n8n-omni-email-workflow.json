{
  "name": "SAM Omni — send email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "sam-omni-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "sam-omni-email"
    },
    {
      "parameters": {
        "jsCode": "// Second gate. SAM already resolved and confirmed the recipient, but this\n// webhook must not be a pass-through: a confused or compromised caller should\n// still be unable to mail an arbitrary address.\n//\n// Keep this list in step with the vault notes carrying an `email:` field.\n// Anything not on it is refused, not sent.\nconst ALLOWED = [\n  'michael@parkfords.co.uk',\n  'ccawood21@gmail.com',\n  'horizon4blinds@gmail.com',\n  'aakademikk01@gmail.com',\n];\n\nconst body = $input.first().json.body ?? $input.first().json;\nconst to = String(body.to ?? '').trim().toLowerCase();\nconst subject = String(body.subject ?? '').slice(0, 200);\nconst text = String(body.body ?? '').slice(0, 10000);\n\nif (!to || !ALLOWED.includes(to)) {\n  return [{ json: { ok: false, code: 403, reason: `Recipient not on the allowlist: ${to || '(empty)'}` } }];\n}\nif (!text.trim()) {\n  return [{ json: { ok: false, code: 400, reason: 'Empty body' } }];\n}\n\nreturn [{ json: { ok: true, to, subject, text, name: String(body.name ?? '') } }];"
      },
      "id": "validate",
      "name": "Validate recipient",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.ok }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "gate",
      "name": "Allowed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.to }}",
        "subject": "={{ $json.subject }}",
        "emailType": "text",
        "message": "={{ $json.text }}",
        "options": {}
      },
      "id": "send",
      "name": "Gmail — send",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        660,
        -100
      ],
      "credentials": {}
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, to: $json.to }) }}",
        "options": {}
      },
      "id": "ok",
      "name": "200 OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        880,
        -100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": "={{ $json.code }}",
        "responseBody": "={{ JSON.stringify({ ok: false, reason: $json.reason }) }}",
        "options": {}
      },
      "id": "refused",
      "name": "Refuse",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        660,
        120
      ]
    }
  ],
  "connections": {
    "Webhook": {
