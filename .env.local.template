# =============================================================================
# SAM Avatar — Server-side API keys
# =============================================================================
# These keys are NEVER exposed to the browser. The Next.js API routes proxy all
# third-party calls so the raw credentials stay on the server.
#
# Copy this file to .env.local and fill in your values:
#   cp .env.local.template .env.local
# =============================================================================

# Simli — WebRTC lip-synced avatar
#   Get your key at: https://simli.com/dashboard
SIMLI_API_KEY="your_simli_api_key_here"
SIMLI_FACE_ID="your_face_id_here"

# ElevenLabs — Text-to-speech
#   Get your key at: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
# ↑ Default: Rachel. Replace with any voice ID from the ElevenLabs Voices tab.

# =============================================================================
# SAM Chat — LLM API
# =============================================================================
# Anthropic-compatible API for the /api/chat endpoint.
# Supports Claude, DeepSeek, or any Anthropic-format API.

# API base URL (default: https://api.anthropic.com)
ANTHROPIC_BASE_URL="https://api.anthropic.com"

# API key / auth token
ANTHROPIC_AUTH_TOKEN="your_api_key_here"

# Model ID (default: claude-sonnet-5)
ANTHROPIC_MODEL="claude-sonnet-5"
